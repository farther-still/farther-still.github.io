{
  "name": "farther-still",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p src/engine/tsconfig.json && tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:repo": "tsx scripts/check-repo.ts",
    "check:prose": "tsx scripts/check-prose.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:repo && npm run check:prose",
    "check:dist": "tsx scripts/check-dist.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
